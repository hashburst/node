  },
  "schemas": [
    "hb-mining-exploration-proposal-v1",
    "hb-mining-exploration-intent-v1",
    "hb-mining-exploration-receipt-v1",
    "hb-rainbowminer-binding-v1"
  ],
  "security_invariants": {
