{
  "schema": "hashburst-release-manifest-v1",
  "release": "v0.1.0-rc2",
  "channel": "release-candidate",
  "base_tag": "v0.1.0-rc1",
  "mainnet": false,
  "production_apply": false,
  "scope": "controlled-exploration-one-worker",
